# Copy to .env.local and fill in. Never commit real values.
# Full explanation of each variable: docs/06-SETUP.md

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Hoshimono
NODE_ENV=development

# --- Database (Postgres) ---
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL=postgresql://user:password@host:5432/hoshimono?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/hoshimono?sslmode=require

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cron (Batch 2.5) ---
# Shared secret the host sends as "Authorization: Bearer <CRON_SECRET>"
# when it calls /api/cron/tick every minute.
CRON_SECRET=generate-with-openssl-rand-base64-32

# --- Payments (Phase 3) ---
# PayMongo, see ADR 0003. Test-mode keys only until launch.
# Without keys, PAYMENT_PROVIDER=fake pays on a local stand-in page
# (development only; refused on a real domain).
PAYMENT_PROVIDER=paymongo
# Development only: E2E_MAILBOX=1 keeps sign-in links in memory, so
# /dev/sign-in can sign in as the test accounts in one click (docs/06).
# E2E_MAILBOX=1
PAYMONGO_SECRET_KEY=
# The secret_key PayMongo returns when the webhook endpoint is created.
PAYMONGO_WEBHOOK_SECRET=

# --- Messaging (Phase 2/4) ---
RESEND_API_KEY=
EMAIL_FROM="Hoshimono <orders@example.com>"
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=

# --- Media ---
# Image storage and CDN (S3-compatible or Cloudinary)
MEDIA_BUCKET=
MEDIA_PUBLIC_URL=

# --- Maps / address (Phase 2) ---
GOOGLE_MAPS_API_KEY=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
